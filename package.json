{
  "name": "onelongpage-pdf",
  "version": "1.3.0",
  "private": true,
  "description": "Chrome extension that saves a whole web page as one continuous PDF page, stamped with the URL and capture time.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "pdf",
    "single-page-pdf",
    "chrome-devtools-protocol"
  ],
  "author": "Jose Fuentes (https://www.linkedin.com/in/josefuentes4096/)",
  "license": "0BSD",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test tests/",
    "test:e2e": "node --experimental-websocket --test tests/e2e/capture.e2e.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
